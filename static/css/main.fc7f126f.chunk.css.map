.navbar > .container {
  margin-left: 0 !important;
}

.nav-item,
.nav-link {
  font-size: large !important;
}

.navbar-brand {
  font-size: x-large !important;
  font-weight: 600;
}

.dropdown-toggle::after {
  display: none !important;
}

.nav-item.dropdown:hover .dropdown-menu {
  display: block;
}

.nav-item.dropdown .dropdown-menu {
  background-color: whitesmoke;
  border: none;
  margin-top: 0;
}

.dropdown-item:focus,
.dropdown-item:hover {
  background-color: transparent !important;
}

.dropdown-item:hover {
  /* font-weight: 600; */
  color: #3f3f8c;
}

.nav-link {
  position: relative;
  color: #000;
  text-decoration: none;
}

.nav-link:hover {
  color: #000;
}

.nav-link::before {
  content: "";
  position: absolute;
  display: block;
  width: 100%;
  height: 2px;
  bottom: 0;
  left: 0;
  background-color: #3f3f8c;
  transform: scaleX(0);
  transition: transform 0.3s ease;
}

.nav-link:hover::before {
  transform: scaleX(1);
}
